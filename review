#!/usr/bin/env python3
"""Simple CLI for code review"""

import sys
import os
import glob
import argparse
from dotenv import load_dotenv
from code_reviewer import CodeReviewer

load_dotenv()

def main():
    parser = argparse.ArgumentParser(description='AI Code Review CLI')
    
    # Mode selection
    parser.add_argument('mode', choices=['local', 'pr', 'publish'], 
                       help='Review mode: local changes, Bitbucket PR, or publish comments')
    
    # Local mode options
    parser.add_argument('--base', default='develop',
                       help='Base branch for local review (default: develop)')
    
    # PR mode options  
    parser.add_argument('--workspace', help='Bitbucket workspace/project (overrides BITBUCKET_WORKSPACE)')
    parser.add_argument('--repo', help='Repository name (overrides BITBUCKET_REPO)')
    parser.add_argument('--pr-id', help='Pull request ID')
    
    # Publish mode options
    parser.add_argument('review_file', nargs='?', 
                       help='Review file to publish (optional for publish mode)')
    
    # Comment control
    parser.add_argument('--min-severity', choices=['suggestion', 'minor', 'major', 'critical'],
                       help='Minimum severity to post as PR comment')
    
    args = parser.parse_args()
    
    # Override env variable if specified
    if args.min_severity:
        os.environ['MIN_SEVERITY_FOR_COMMENTS'] = args.min_severity
    
    try:
        reviewer = CodeReviewer()
        
        if args.mode == 'local':
            print(f"🔍 Reviewing local changes against '{args.base}' branch...")
            reviews = reviewer.review_local_changes(args.base)
            
        elif args.mode == 'pr':
            # Use environment variables as defaults, CLI args as overrides
            workspace = args.workspace or os.getenv('BITBUCKET_WORKSPACE')
            repo = args.repo or os.getenv('BITBUCKET_REPO')
            pr_id = args.pr_id
            
            if not all([workspace, repo, pr_id]):
                missing = []
                if not workspace: missing.append('workspace (--workspace or BITBUCKET_WORKSPACE)')
                if not repo: missing.append('repo (--repo or BITBUCKET_REPO)')
                if not pr_id: missing.append('pr-id (--pr-id)')
                print(f"❌ Error: Missing required parameters: {', '.join(missing)}")
                print("Example: ./review pr --workspace CTAPPS --repo imageresizer --pr-id 120")
                sys.exit(1)
            
            print(f"🔍 Reviewing PR #{pr_id} in {workspace}/{repo}...")
            reviews = reviewer.review_pull_request(workspace, repo, pr_id)
            
        elif args.mode == 'publish':
            review_file = args.review_file
            
            # If no file specified, use the latest one
            if not review_file:
                review_files = glob.glob('reviews/pr_*.json')
                if not review_files:
                    print("❌ No review files found. Run a PR review first.")
                    sys.exit(1)
                review_file = max(review_files, key=os.path.getctime)
                print(f"📄 Using latest review file: {review_file}")
            
            print(f"📤 Publishing comments from: {review_file}")
            if args.min_severity:
                print(f"📝 Comment threshold: {args.min_severity} and above")
            
            comments_added = reviewer.publish_comments(review_file, args.min_severity)
            print(f"✅ Published {comments_added} comments!")
            return
        
        # Print results for local/pr modes
        if reviews:
            print(f"\n✅ Review complete! Found {len(reviews)} items to review.")
            reviewer.print_local_review(reviews)
        else:
            print("\n✅ No issues found or no files to review.")
            
    except Exception as e:
        print(f"❌ Error: {e}")
        sys.exit(1)

if __name__ == '__main__':
    main()
